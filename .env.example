GEMINI_API_KEY=
# Modelo de Gemini a utilizar
GEMINI_MODEL_TEXT=gemini-2.5-flash


# Directorio local donde se guardan los modelos PHP extraídos de repositorio laravel

# MODELS_SCHEMA_DIR=./data/models_schema-monica
MODELS_SCHEMA_DIR=./data/models_schema-inventario-ti-laravel



# Ruta al archivo JSON con el benchmark de preguntas

# BENCHMARK_FILE=./data/benchmark-monica.json
BENCHMARK_FILE=./data/benchmark-inventario-ti-laravel.json

BENCHMARK_OUTPUT_DIR=data

# MODELS_PATH=../monica/app/Models
MODELS_PATH=../inventario-ti-laravel/app/Model
# MODELS_PATH=../inventario-ti-laravel/app/Models


# Directorio donde EloquentSchemaExtractor guarda el esquema generado
SCHEMA_OUTPUT_DIR=data